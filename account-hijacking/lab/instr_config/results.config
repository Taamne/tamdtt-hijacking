# results.config -- web-attk-account-hijacking
#
# All evidence is server-side, recorded by the portal into
# /var/log/victim-web/app.log (outside any user HOME so the Labtainer
# artifact collector can package it):
#  - credential_discovered: the stale backup file was actually fetched
#    over HTTP from the attacker container.
#  - victim_login: the portal recorded a successful victim login coming
#    from the attacker container IP.
#  - account_hijacked: the portal recorded the victim private profile
#    being served to the victim session from the attacker IP.
# Simply printing the flag on the attacker terminal creates none of
# these server-side records, so it cannot pass checkwork.

credential_discovered = victim-web:/var/log/victim-web/app.log : CONTAINS : GET /old/portal_backup_2024_old.txt src=172.26.0.3
victim_login = victim-web:/var/log/victim-web/app.log : CONTAINS : LOGIN_SUCCESS user=victim src=172.26.0.3
account_hijacked = victim-web:/var/log/victim-web/app.log : CONTAINS : PROFILE_ACCESS user=victim src=172.26.0.3 status=200
