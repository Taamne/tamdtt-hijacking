# Filename : start.config
# web-detk-email-forwarding: Email Forwarding detection lab.
# Three containers: victim-mail (portal + audit log), attacker (threat
# emulator), analyst (SOC workstation: pull logs, diff, detect).

GLOBAL_SETTINGS
	# GRADE_CONTAINER - container where instructor will perform grading
	GRADE_CONTAINER analyst

	# HOST_HOME_XFER - directory to transfer artifact to/from containers
	HOST_HOME_XFER seed_dir/

	# LAB_MASTER_SEED - master seed string specific to this laboratory
	LAB_MASTER_SEED web-detk-email-forwarding_master_seed_v1

	# Registry holding this lab's images (taamne = author's DockerHub).
	# Students pull images from here; no local build needed.
	REGISTRY taamne

        # Uncomment the following to cause the content of the lab/docs directory
        # to be collected and included in the student artifacts.
        # COLLECT_DOCS YES

NETWORK LAB_NET
	MASK 172.26.0.0/24
	GATEWAY 172.26.0.1

CONTAINER victim-mail
	USER ubuntu
	LAB_NET 172.26.0.2

CONTAINER attacker
	USER ubuntu
	LAB_NET 172.26.0.3

CONTAINER analyst
	USER ubuntu
	LAB_NET 172.26.0.4
