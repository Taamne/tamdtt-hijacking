# results.config -- web-detk-email-forwarding
#
# Grading is based on SOC work products derived from server-side evidence:
#  - rogue_forward_detected: the detector actually fired on the rogue
#    exfiltration rule (server log + DB prove the attack happened).
#  - no_false_positive: SUMMARY shows exactly one true positive and zero
#    false positives (the approved partner/internal rules stay silent).
#  - allowlist_applied: the detector config was switched to the
#    inventory-derived allowlist mode (the intended fix, not another
#    hardcoded IOC).
# Hand-writing alerts.log cannot reproduce a consistent run (timestamps,
# inventory lines and SUMMARY must agree with the collected evidence).

rogue_forward_detected = analyst:/var/log/soc/alerts.log : CONTAINS : ALERT forward victim->payroll-archive@company-backup.com
no_false_positive = analyst:/var/log/soc/alerts.log : CONTAINS : SUMMARY tp=1 fp=0
allowlist_applied = analyst:/var/log/soc/alerts.log : CONTAINS : CONFIG mode=allowlist
