# results.config -- web-attk-email-hijacking
#
#  - credential_discovered: the readable packet capture saved by the
#    student at /tmp/output.txt on attacker actually contains the
#    victim mailbox password (proves the plaintext login was sniffed;
#    /tmp is outside any user HOME so the collector can package it).
#  - mailbox_login: the webmail recorded a successful victim login
#    coming from the attacker container IP (server-side event).
#  - email_hijacked: the webmail recorded the victim private mail
#    being read by the victim session from the attacker IP.
# Printing the flag on the attacker terminal creates none of these
# records (the capture file must hold the real sniffed traffic).

credential_discovered = attacker:/tmp/output.txt : CONTAINS : Vict1m_Mail!2026
mailbox_login = victim-mail:/var/log/victim-mail/mail.log : CONTAINS : MAILBOX_LOGIN_SUCCESS user=victim src=172.27.0.3
email_hijacked = victim-mail:/var/log/victim-mail/mail.log : CONTAINS : EMAIL_READ id=2 user=victim src=172.27.0.3 status=200
