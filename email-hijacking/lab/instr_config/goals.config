# goals.config -- web-attk-email-hijacking
#
# Please see ..../docs/goals.config.format

credential_ok = matchany : string_equal : credential_discovered : answer=True
mailbox_login_ok = matchany : string_equal : mailbox_login : answer=True
email_hijacked_ok = matchany : string_equal : email_hijacked : answer=True
forwarding_ok = matchany : string_equal : forwarding_rule_set : answer=True
