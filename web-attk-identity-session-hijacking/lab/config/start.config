# Filename : start.config
# web-attk-identity-session-hijacking: end-to-end identity & session
# hijacking DEMO (no grading). Four containers:
#   victim-portal (Flask/FastAPI portal + webmail + JWT API + JSONL audit)
#   attacker      (student shell + Firefox GUI for the web steps)
#   victim        (baseline user01: valid login + token + polling)
#   monitor       (log correlation / incident timeline)

GLOBAL_SETTINGS
	# GRADE_CONTAINER - kept for Labtainer compatibility; this lab is not graded.
	GRADE_CONTAINER victim-portal

	# HOST_HOME_XFER - directory to transfer artifact to/from containers
	HOST_HOME_XFER seed_dir/

	# LAB_MASTER_SEED - master seed string specific to this laboratory
	LAB_MASTER_SEED web-attk-identity-session-hijacking_master_seed_v1

	# Registry holding this lab's images (taamne = author's DockerHub).
	REGISTRY taamne

NETWORK LAB_NET
	MASK 172.26.0.0/24
	GATEWAY 172.26.0.1

CONTAINER victim-portal
	USER ubuntu
	LAB_NET 172.26.0.2
	# Fallback when the host has no X11: uncomment PUBLISH and comment
	# X11 YES below, then open http://127.0.0.1:8000 in the host browser.
	#PUBLISH 127.0.0.1:8000:8000

CONTAINER attacker
	USER ubuntu
	LAB_NET 172.26.0.3
	# Firefox GUI is forwarded to the host X server (Labtainer X11 support).
	X11 YES

CONTAINER victim
	USER ubuntu
	LAB_NET 172.26.0.4

CONTAINER monitor
	USER ubuntu
	LAB_NET 172.26.0.5
