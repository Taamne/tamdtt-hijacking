# Filename : start.config
# web-attk-token-hijacking: Token Hijacking practice lab.
# Three containers: attacker (student shell), victim (scripted session
# keeper), victim-portal (Flask token-auth portal + debug endpoint).

GLOBAL_SETTINGS
	# GRADE_CONTAINER - container where instructor will perform grading
	GRADE_CONTAINER victim-portal

	# HOST_HOME_XFER - directory to transfer artifact to/from containers
	HOST_HOME_XFER seed_dir/

	# LAB_MASTER_SEED - master seed string specific to this laboratory
	LAB_MASTER_SEED web-attk-token-hijacking_master_seed_v1

	# Registry holding this lab's images (taamne = author's DockerHub).
	# Students pull images from here; no local build needed.
	REGISTRY taamne

        # Uncomment the following to cause the content of the lab/docs directory
        # to be collected and included in the student artifacts.
        # COLLECT_DOCS YES

NETWORK TOK_NET
	MASK 172.28.0.0/24
	GATEWAY 172.28.0.1

CONTAINER victim-portal
	USER ubuntu
	TOK_NET 172.28.0.2

CONTAINER attacker
	USER ubuntu
	TOK_NET 172.28.0.3

CONTAINER victim
	USER ubuntu
	TOK_NET 172.28.0.4
