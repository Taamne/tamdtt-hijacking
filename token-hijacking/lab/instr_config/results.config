# results.config -- web-attk-token-hijacking
#
# All evidence is server-side, recorded by the portal into
# /var/log/victim-portal/portal.log (outside any user HOME so the
# Labtainer artifact collector can package it):
#  - token_discovered: the forgotten debug endpoint was actually
#    queried from the attacker container.
#  - session_replayed: the victim bearer token arrived from the
#    attacker IP (different from the IP it was issued to).
#  - token_hijacked: the victim private profile was served to the
#    replayed session from the attacker IP.
# Printing the flag on the attacker terminal creates none of these
# records, and tokens are unguessable randoms, so echo cannot pass.

token_discovered = victim-portal:/var/log/victim-portal/portal.log : CONTAINS : DEBUG_ACCESS src=172.28.0.3
session_replayed = victim-portal:/var/log/victim-portal/portal.log : CONTAINS : TOKEN_REPLAY user=victim src=172.28.0.3
token_hijacked = victim-portal:/var/log/victim-portal/portal.log : CONTAINS : PROFILE_ACCESS user=victim src=172.28.0.3 via=replay
